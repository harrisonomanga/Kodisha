DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=*
# Leave POSTGRES_DB unset to use SQLite for local development
POSTGRES_DB=rentals
POSTGRES_USER=rentals
POSTGRES_PASSWORD=rentals
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# CELERY_EAGER=1 runs jobs inline (dev/tests). Set to 0 with a Redis broker in staging/production.
CELERY_EAGER=1
CELERY_BROKER_URL=redis://localhost:6379/0
